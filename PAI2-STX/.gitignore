# Entornos y caches
.venv/
.venv-wsl/
__pycache__/
.pytest_cache/
*.pyc
.git/
# PKI real, estado de las cuentas y secretos
pki/ca/*.crt
pki/ca/*.key
pki/ca/*.pem
pki/ca/revoked.json
pki/server/*.crt
pki/server/*.key
pki/clients/**
!pki/clients/.gitkeep
*.csr
*.p12
*.pfx
*.ovpn
credenciales.csv
data/*.sqlite3*
data/backups/
.env
.env.*
# Evidencias y informes locales
evidencias/logs/*
evidencias/pcap/*
evidencias/ataques/*
bench/resultados/*
!**/.gitkeep
*.log
*.zip
_respaldo*
