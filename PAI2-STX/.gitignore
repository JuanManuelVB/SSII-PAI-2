# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-wsl/

# Estado local del laboratorio (se regenera con laboratorio.sh)
data/*.sqlite3
data/*.sqlite3-*
data/backups/

# PKI: nunca versionar claves, certificados emitidos ni contraseñas
pki/**/*.key
pki/**/*.csr
pki/**/*.crt
pki/**/*.pem
pki/**/*.p12
pki/ca/revoked.json
pki/clients/
!pki/**/.gitkeep

# VPN / Access Server
.env
.env.*
*.ovpn

# Evidencias generadas que pueden contener datos sensibles
evidencias/logs/*.jsonl
evidencias/pcap/*.pcap*

# Paquetes y respaldos
*.zip
*.tgz
*.tar
_respaldo*
