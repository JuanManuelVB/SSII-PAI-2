# Solo ejemplo. Rellenar localmente y NUNCA versionar el .env real.
BYODSEC_AS_URL=https://localhost:943
BYODSEC_AS_ADMIN_USER=openvpn
BYODSEC_AS_ADMIN_PASSWORD=RELLENAR_SOLO_EN_ENTORNO_LOCAL
BYODSEC_AS_CA_BUNDLE=/usr/local/openvpn_as/etc/web-ssl/ca.crt
# Cambiar a confirmed solo DESPUES de provisionar usuarios con deny=true.
BYODSEC_VPN_DEFAULT_DENY=NOT_CONFIRMED
