[Unit]
Description=BYODSEC - reconciliar autorizaciones VPN (REST)
After=network-online.target

[Service]
Type=oneshot
# Cambiar el usuario/ruta en el despliegue; no usar claves en esta plantilla.
User=byodsec
WorkingDirectory=/opt/byodsec/PAI2-STX
EnvironmentFile=/etc/byodsec/rest.env
ExecStart=/usr/bin/python3 -m src.vpn_rest_as.reconciliar
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/byodsec/PAI2-STX/data /opt/byodsec/PAI2-STX/evidencias
